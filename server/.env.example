# PostgreSQL connection. `npm run db:setup` creates the database if it does not exist.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/ai_sourcing

PORT=4000
CORS_ORIGIN=http://localhost:5173

# AI_MODE: "live" searches the web for real suppliers with AI; "mock" returns generated demo suppliers.
# Defaults to "live" when the chosen provider's key is set, otherwise "mock".
AI_MODE=mock

# AI_PROVIDER: "gemini" (Google Search grounding) or "anthropic" (Claude + web search).
# Defaults to gemini when GEMINI_API_KEY is set.
AI_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey (starts with "AIza", 39 characters)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative: Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# WEB_SEARCH_TOOL=web_search_20250305

# How many suppliers to keep per request, and how many web searches Claude may run (Gemini decides itself).
MAX_SUPPLIERS=5
MAX_WEB_SEARCHES=6

# ---------------------------------------------------------------------------
# Email. Default "simulated": emails are recorded but never sent (demo + tests).
# "smtp": real delivery, ONLY to addresses in EMAIL_ALLOWED_RECIPIENTS. Recipients are never redirected.
EMAIL_TRANSPORT=simulated
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465                      # 465 = TLS (SMTP_SECURE defaults to true), 587 = STARTTLS
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-gmail-app-password  # Google account → Security → 2-Step Verification → App passwords
# EMAIL_FROM="Sourcing Desk <you@gmail.com>"
# EMAIL_REPLY_TO=you@gmail.com       # where suppliers' replies go: the inbox polled below (same account as SMTP_USER)
# Comma-separated test supplier addresses, or "@domain" for a whole domain:
# EMAIL_ALLOWED_RECIPIENTS=supplier1@tempmail-domain,supplier2@tempmail-domain
# Only for real suppliers; refused while AI_MODE=mock:
# EMAIL_ALLOW_ANY_RECIPIENT=false

# Simulated suppliers answer proposals and counter-offers. Defaults to true with simulated
# email and false with smtp (so they never race real replies).
# SIMULATE_SUPPLIERS=true
SIM_REPLY_DELAY_SECONDS=3-8
# Seconds to wait for a supplier reply each round before closing that supplier.
# Use a few hours (e.g. 14400) when humans reply to real emails.
REPLY_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Inbound replies. Suppliers reply to EMAIL_REPLY_TO, so that is the mailbox we read.
# "none" (default): replies come only from the simulator or POST /api/webhooks/email.
# "imap": poll that inbox over IMAP every INBOUND_POLL_SECONDS, signing in with SMTP_USER / SMTP_PASS
#   (for Gmail: the same App Password used for sending; no other setup needed).
INBOUND_PROVIDER=none
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_MAILBOX=INBOX
# INBOUND_SINCE_DAYS=7               # only mail received in the last N days is checked
# INBOUND_POLL_SECONDS=15
# Optional shared secret for POST /api/webhooks/email (sent as X-Webhook-Secret).
INBOUND_WEBHOOK_SECRET=

# Set to false to run the API without the background worker (e.g. a separate worker process).
RUN_WORKER=true
